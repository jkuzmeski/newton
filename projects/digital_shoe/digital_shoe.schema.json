{
  "$id": "https://newton-physics.github.io/digital-shoe/digital_shoe.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "column_bed": {
      "required": [
        "anchor_bottom_m",
        "rest_length_m",
        "area_m2",
        "neighbors",
        "spacing_m"
      ],
      "type": "object"
    },
    "constitutive_model": {
      "properties": {
        "parameters": {
          "description": "Two-term Ogden-Hill (Hyperfoam) equilibrium series plus one Maxwell branch. instantaneous_shear_modulus_2_pa and hyperfoam_exponent_2 describe the second term and stay optional so single-term artifacts written before it remain valid; an absent second modulus is zero, which disables the term and reproduces the single-term law exactly. The series equilibrium shear modulus, which pins the Pasternak coupling, is the SUM (instantaneous_shear_modulus_pa + instantaneous_shear_modulus_2_pa) * equilibrium_fraction.",
          "required": [
            "instantaneous_shear_modulus_pa",
            "hyperfoam_exponent",
            "equilibrium_fraction",
            "pasternak_n_per_m",
            "effective_poisson_ratio",
            "maxwell_relaxation_time_s"
          ],
          "type": "object"
        },
        "type": {
          "const": "effective_hyperfoam_maxwell_pasternak_foundation"
        }
      },
      "required": [
        "type",
        "parameters"
      ],
      "type": "object"
    },
    "coordinate_system": {
      "required": [
        "handedness",
        "up_axis",
        "length_unit",
        "force_unit",
        "origin"
      ],
      "type": "object"
    },
    "identification": {
      "type": "object"
    },
    "instron_fixtures": {
      "type": "object"
    },
    "provenance": {
      "type": "object"
    },
    "schema_version": {
      "const": "digital_shoe_1"
    },
    "shoe": {
      "required": [
        "id",
        "model_scope"
      ],
      "type": "object"
    },
    "validation": {
      "type": "object"
    },
    "visual_meshes": {
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "shoe",
    "coordinate_system",
    "constitutive_model",
    "column_bed",
    "validation",
    "provenance"
  ],
  "title": "Portable Digital Shoe",
  "type": "object"
}
