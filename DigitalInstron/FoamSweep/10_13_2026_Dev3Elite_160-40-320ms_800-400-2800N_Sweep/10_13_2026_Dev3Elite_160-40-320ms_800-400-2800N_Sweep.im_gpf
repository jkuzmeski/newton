              </Node>
              <Node name="User-Defined Tracking Channel Calculation">
                <Item name="Type">
                  <Value xsi:type="xsd:string">Instron.Calculations.DerivedRawChannelCalc</Value>
                </Item>
                <Item name="NameParameter">
                  <Value xsi:type="Node" name="NameParameter">
                    <Item name="Value">
                      <Value xsi:type="xsd:string">User-Defined Tracking Channel Calculation</Value>
                    </Item>
                  </Value>
                </Item>
                <Item name="NumberOfChannels">
                  <Value xsi:type="Node" name="NumberOfChannels">
                    <Item name="Value">
                      <Value xsi:type="xsd:int">1</Value>
                    </Item>
                  </Value>
                </Item>
                <Item name="Formula">
                  <Value xsi:type="Node" name="Formula">
                    <Item name="Value">
                      <Value xsi:type="xsd:string">// example for averaging the source channels
for (int i = 0; i &lt; valueCount; i++)
{
    result[i] = 0;
    for (int channel = 0; channel &lt; channelCount; channel++)
    {
        result[i] += source[channel][i];
    }
    result[i] /= channelCount;
}</Value>
                    </Item>
                  </Value>
                </Item>
                <Item name="CustomUnit">
                  <Value xsi:type="Node" name="CustomUnit">
                    <Item name="Value">
                      <Value xsi:type="xsd:string" />
                    </Item>
                  </Value>
