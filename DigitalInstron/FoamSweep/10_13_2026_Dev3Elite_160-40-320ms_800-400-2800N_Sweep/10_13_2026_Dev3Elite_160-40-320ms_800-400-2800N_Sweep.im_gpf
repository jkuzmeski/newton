                        </Item>
                      </Value>
                    </Item>
                    <Item name="UserDefinedUnits">
                      <Value xsi:type="Node" name="UserDefinedUnits">
                        <Item name="Value">
                          <Value xsi:type="xsd:int">0</Value>
                        </Item>
                        <Item name="UnitName">
