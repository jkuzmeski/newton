                      <Value xsi:type="xsd:string">//Replace 0 with the displayed force-sweep LoopNumber minus 1
const int forceSweepLoopIndex = 0;

int repeat = cycleDataSet.LoopCounts[forceSweepLoopIndex];

if (repeat == 0)
{
result = -800;
}

else if (repeat &gt;= 1 &amp;&amp; repeat &lt;=7)
{
result = -(800 + 400 * (repeat -1));
}

else 
{
result = double.NaN;
}



