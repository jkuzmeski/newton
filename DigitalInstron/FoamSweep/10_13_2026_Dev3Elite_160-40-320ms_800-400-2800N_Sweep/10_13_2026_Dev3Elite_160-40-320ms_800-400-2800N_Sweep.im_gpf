                <Item name="NameParameter">
                  <Value xsi:type="Node" name="NameParameter">
                    <Item name="Value">
                      <Value xsi:type="xsd:string">User-Defined Peak &amp; Trend Channel Calculation</Value>
                    </Item>
                  </Value>
                </Item>
                <Item name="NumberOfChannels">
                  <Value xsi:type="Node" name="NumberOfChannels">
                    <Item name="Value">
                      <Value xsi:type="xsd:int">1</Value>
                    </Item>
                  </Value>
                </Item>
                <Item name="Formula">
                  <Value xsi:type="Node" name="Formula">
                    <Item name="Value">
                      <Value xsi:type="xsd:string">// example for finding the largest value in the first source channel
result = source[0][0];
for (int i = 0; i &lt; valueCount; i++)
{
    result = Math.Max(result, source[0][i]);
}</Value>
                    </Item>
                  </Value>
                </Item>
                <Item name="CustomUnit">
                  <Value xsi:type="Node" name="CustomUnit">
                    <Item name="Value">
                      <Value xsi:type="xsd:string" />
                    </Item>
